APP_ENV=development
APP_LOG_LEVEL=INFO
DATABASE_URL=mysql+pymysql://marklens:marklens@127.0.0.1:3307/marklens?charset=utf8mb4
TEXT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
IMAGE_EMBEDDING_MODEL=Qdrant/resnet50-onnx
OCR_PROVIDER=rapidocr
MODEL_CACHE_DIR=.model-cache
UPLOAD_DIR=data/uploads
SOURCE_DATA_DIR=data/sources
CORS_ORIGINS=http://localhost:5173
AUTH_SECRET=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14
COOKIE_SECURE=false
DEMO_ADMIN_EMAIL=operator@example.com
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password
HEALTH_CHECK_SECRET=
MODEL_RUNTIME_ENABLED=true
AGENT_EAGER=false
