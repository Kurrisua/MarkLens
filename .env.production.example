# Copy to /opt/marklens/.env on the server. Do not commit the real file.
APP_ENV=production
APP_LOG_LEVEL=INFO
DATABASE_URL=mysql+pymysql://marklens:replace-with-db-password@127.0.0.1:3306/marklens?charset=utf8mb4
AUTH_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true
CORS_ORIGINS=http://your-server-ip
MODEL_RUNTIME_ENABLED=true
MODEL_CACHE_DIR=.model-cache
UPLOAD_DIR=data/uploads
SOURCE_DATA_DIR=data/sources
DEMO_ADMIN_EMAIL=operator@example.com
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password
HEALTH_CHECK_SECRET=replace-with-health-secret
